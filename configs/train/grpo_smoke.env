# Source this file before running examples/train/grpo/train.sh.

MODEL=/path/to/open-audio-llm-hf-checkpoint
DATASET=/path/to/grpo_smoke.jsonl
OUTPUT_DIR=runs/open_audio_llm_grpo_smoke

CUDA_VISIBLE_DEVICES=0
NPROC_PER_NODE=1
MAX_STEPS=1
PER_DEVICE_TRAIN_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=1
NUM_GENERATIONS=2
MAX_COMPLETION_LENGTH=256
SAVE_STEPS=1
LOGGING_STEPS=1

USE_VLLM=false
VLLM_SERVER_HOST=127.0.0.1
VLLM_SERVER_PORT=8006

DEEPSPEED=zero2
LORA_RANK=64
LORA_ALPHA=128
LEARNING_RATE=1e-6
