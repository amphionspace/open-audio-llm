# Source this file before running examples/train/rollout/run_rollout_server.sh.

MODEL=/path/to/merged-open-audio-llm-hf-checkpoint
# Optional. Defaults to ${MODEL}_vllm_rollout and is generated automatically.
ROLLOUT_MODEL=
# vLLM 0.18 generic Transformers backend used for rollout smoke startup.
VLLM_COMPAT_ARCHITECTURE=TransformersForCausalLM
CUDA_VISIBLE_DEVICES=0
PORT=8006
TP_SIZE=1
DP_SIZE=1
GPU_MEMORY_UTILIZATION=0.6
MAX_MODEL_LEN=1024
ENFORCE_EAGER=true
