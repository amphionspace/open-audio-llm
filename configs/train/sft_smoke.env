# Source this file before running examples/train/sft/train.sh.

MODEL=/path/to/open-audio-llm-hf-checkpoint
DATASET=/path/to/sft_smoke.jsonl
OUTPUT_DIR=runs/open_audio_llm_sft_smoke

CUDA_VISIBLE_DEVICES=0
NPROC_PER_NODE=1
MAX_STEPS=1
PER_DEVICE_TRAIN_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=1
SAVE_STEPS=1
LOGGING_STEPS=1

TRAIN_TYPE=lora
DEEPSPEED=zero2
LORA_RANK=64
LORA_ALPHA=128
LEARNING_RATE=1e-5
