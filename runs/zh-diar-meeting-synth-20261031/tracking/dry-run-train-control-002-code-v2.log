    stage_max_steps: 12000
    expected_world_size: 8
    analysis_base_commit: b18268e
  cluster:
    kind: acp
    sco_home: /workspace/workspace/mingdong/.local-tools/sco
    credentials: /workspace/workspace/mingdong/repo/open-audio-llm/third_party/amphionkeys/sensecore.env
    workspace: workspace-whai
    aec2: cluster-whai
    image: registry.cn-sh-01.sensecore.cn/ccr-wh/amphion-base:amphion-base-20260923072955
    worker_spec: N3lS.Ii.I60.94c944g
    nodes: 1
    priority: NORMAL
    quota_type: reserved
    wait: true
    mounts:
    - 01a0c847-3d8d-7b42-8c75-50cbd189bb56:/workspace
    environment:
      NCCL_IB_TIMEOUT: 22
      NCCL_IB_RETRY_CNT: 13
      NCCL_IB_AR_THRESHOLD: 0
  storage:
    executable: /workspace/workspace/mingdong/.local/share/amphion-bucket/cluster-venv/bin/ab
    remote: whai:open-audio-llm
    local_root: /workspace/workspace/mingdong/repo/oal-diar-restart
  config_file: /workspace/workspace/mingdong/repo/oal-diar-restart/runs/zh-diar-meeting-synth-20261031/configs/train-control.yaml
cluster_submit_command:
- /workspace/workspace/mingdong/.local-tools/sco/bin/sco
- acp
- jobs
- create
- --workspace-name=workspace-whai
- --aec2-name=cluster-whai
