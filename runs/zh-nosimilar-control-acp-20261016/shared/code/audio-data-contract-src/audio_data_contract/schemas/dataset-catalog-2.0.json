{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amphionspace/audio-data-contract/schemas/dataset-catalog-2.0.json",
  "title": "DatasetSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "version",
    "languages",
    "tasks",
    "artifacts",
    "splits"
  ],
  "properties": {
    "schema_version": {"const": "dataset-catalog/2.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "splits": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/split"}
    },
    "provenance": {"type": "object"},
    "derived_from": {"type": "string", "minLength": 1},
    "recipe_parameters": {"type": "object"}
  },
  "$defs": {
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts"],
      "properties": {
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "group": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "statistics": {"type": "object"},
        "provenance": {"type": "object"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "root_alias", "relative_path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "root_alias": {"type": "string", "minLength": 1},
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "expected_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "metadata": {"type": "object"}
      }
    }
  }
}
