{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amphionspace/audio-data-contract/schemas/audio-example-1.0.json",
  "title": "AudioExample",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "task", "messages"],
  "properties": {
    "schema_version": {"const": "audio-example/1.0"},
    "id": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "content": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "text"],
                  "properties": {
                    "type": {"const": "text"},
                    "text": {"type": "string"}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "slot", "ref"],
                  "properties": {
                    "type": {"const": "audio"},
                    "slot": {"type": "string", "minLength": 1},
                    "purpose": {"type": "string"},
                    "ref": {"$ref": "#/$defs/audio_ref"}
                  }
                }
              ]
            }
          }
        }
      }
    },
    "labels": {"type": "object"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "audio_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "version", "split", "cut_id"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "split": {"type": "string", "minLength": 1},
        "cut_id": {"type": "string", "minLength": 1},
        "channel": {
          "oneOf": [
            {"type": "integer"},
            {"type": "array", "items": {"type": "integer"}}
          ]
        },
        "start": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "purpose": {"type": "string"}
      }
    }
  }
}
