{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amphionspace/audio-data-contract/schemas/dataset-view-1.0.json",
  "title": "DatasetViewSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "view_id",
    "version",
    "source",
    "transforms",
    "result",
    "materialization",
    "lineage_status"
  ],
  "properties": {
    "schema_version": {"const": "dataset-view/1.0"},
    "view_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/dataset_ref"},
    "transforms": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/transform"}
    },
    "result": {"$ref": "#/$defs/dataset_ref"},
    "materialization": {"enum": ["full", "overlay"]},
    "lineage_status": {"enum": ["exact", "inferred"]},
    "provenance": {"type": "object"}
  },
  "$defs": {
    "dataset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "version"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "kind", "writes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "writes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "overrides": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "parameters": {"type": "object"}
      }
    }
  }
}
