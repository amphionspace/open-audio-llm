{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amphionspace/audio-data-contract/schemas/audio-record-1.0.json",
  "title": "AudioRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "task", "audio_slots", "target"],
  "properties": {
    "schema_version": {"const": "audio-record/1.0"},
    "id": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "audio_slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ref"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string"},
          "ref": {"$ref": "#/$defs/audio_ref"}
        }
      }
    },
    "target": {"type": "string"},
    "language": {"type": "string"},
    "labels": {"type": "object"},
    "hotwords": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "audio_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "version", "split", "cut_id"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "split": {"type": "string", "minLength": 1},
        "cut_id": {"type": "string", "minLength": 1},
        "channel": {
          "oneOf": [
            {"type": "integer"},
            {"type": "array", "items": {"type": "integer"}}
          ]
        },
        "start": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "purpose": {"type": "string"}
      }
    }
  }
}
