# 从仓库根目录执行：set -a; source examples/configs/train/sft.env; set +a

# 必填：本项目格式的 HF 模型目录；启动前替换占位路径。
MODEL=/path/to/open-audio-llm-hf-checkpoint

# Catalog 数据 YAML，路径相对启动时的工作目录；从仓库根目录启动。
DATA_CONFIG=examples/configs/data/catalog_mixed.yaml

# 训练输出目录，保存模型、优化器状态、日志和采样位置。
OUTPUT_DIR=runs/catalog-sft

# 数据契约仓库路径；目录下提供 catalog/ 和本机 roots.json。
AUDIO_DATA_CONTRACT_ROOT=/222042021/mingdong/workspace/audio-data-contract

# 允许使用的物理 GPU 编号；本示例仅使用 2、3。
CUDA_VISIBLE_DEVICES=2,3

# 本机训练进程数，普通 DDP 应等于可见 GPU 数量。
NPROC_PER_NODE=2

# 本机分布式通信端口；同时启动多任务时避免冲突。
MASTER_PORT=29501

# 优化器更新次数上限，SFT 动态 batch 要求为正数。
MAX_STEPS=1000

# 每卡固定 batch 条数；SFT 设置 YAML 时长预算后由 batching 控制。
PER_DEVICE_TRAIN_BATCH_SIZE=1

# 每次优化器更新累积的 micro-batch 数。
GRADIENT_ACCUMULATION_STEPS=4

# 每个 rank 的音频读取和增强子进程数；0 在主进程执行。
DATALOADER_NUM_WORKERS=2

# 是否冻结音频 encoder；false 时允许对应参数参与微调。
FREEZE_VIT=true

# 是否冻结音频到 LLM 的 connector。
FREEZE_ALIGNER=false

# 是否冻结语言模型；可用这三个冻结开关配置分阶段训练。
FREEZE_LLM=false

# 微调方式；lora 训练低秩适配参数，full 为全参数微调。
TUNER_TYPE=lora

# ms-swift 内置 DeepSpeed 配置名，如 zero2；控制训练状态分片。
DEEPSPEED=zero2

# 训练精度；bfloat16 需要支持 bf16 的 GPU。
TORCH_DTYPE=bfloat16

# LoRA 低秩矩阵的秩；仅 tuner_type=lora 时生效。
LORA_RANK=64

# LoRA 缩放系数；实际缩放与 rank 有关。
LORA_ALPHA=128

# 应用 LoRA 的模块；all-linear 表示符合冻结规则的线性层。
TARGET_MODULES=all-linear

# 训练输入序列长度上限，包含文本和音频占位 token。
MAX_LENGTH=2048

# 优化器初始学习率。
LEARNING_RATE=1e-5

# 学习率调度方式；cosine 为余弦衰减。
LR_SCHEDULER_TYPE=cosine

# 预热更新占总更新次数的比例，范围 [0,1]。
WARMUP_RATIO=0.05

# 是否用重计算节省激活显存，会增加计算耗时。
GRADIENT_CHECKPOINTING=true

# 每多少次优化器更新保存一次 checkpoint。
SAVE_STEPS=200

# 最多保留的 checkpoint 数量。
SAVE_TOTAL_LIMIT=2

# 每多少次更新验证；需要 YAML 中存在 validation。
EVAL_STEPS=200

# 每多少次更新输出训练日志。
LOGGING_STEPS=10

# 分布式通信超时，单位秒。
DDP_TIMEOUT=180000000

# 可选恢复目录；为空启动新训练，恢复须保留原数据和 batch 配置。
RESUME_FROM_CHECKPOINT=
