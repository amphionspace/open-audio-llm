# 从仓库根目录执行：set -a; source examples/configs/train/rollout.env; set +a

# 必填：本项目格式的 HF 模型目录；启动前替换占位路径。
MODEL=/path/to/merged-open-audio-llm-hf-checkpoint

# 可选 rollout 适配目录；为空时使用 MODEL 后加 _vllm_rollout。
ROLLOUT_MODEL=

# rollout 副本使用的模型架构名，须与安装的 vLLM 后端兼容。
VLLM_COMPAT_ARCHITECTURE=TransformersForCausalLM

# 允许使用的物理 GPU 编号；本示例仅使用 2、3。
CUDA_VISIBLE_DEVICES=3

# rollout HTTP 服务监听端口。
PORT=8006

# rollout tensor parallel 进程数。
TP_SIZE=1

# rollout data parallel 副本数。
DP_SIZE=1

# 每张 GPU 可供 vLLM 使用的显存比例，范围 (0,1)。
GPU_MEMORY_UTILIZATION=0.6

# rollout 总上下文长度上限，包含 prompt 和生成 token。
MAX_MODEL_LEN=1024

# true 使用 eager 执行，适合冒烟测试；关闭后可用 CUDA graph。
ENFORCE_EAGER=true
