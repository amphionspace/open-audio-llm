# 从仓库根目录执行：set -a; source examples/configs/train/grpo.env; set +a
# 外置 rollout 时必须另留 GPU，并同步修改本文件的可见 GPU 和进程数。

# 必填：本项目格式的 HF 模型目录；启动前替换占位路径。
MODEL=/path/to/open-audio-llm-hf-checkpoint

# Catalog 数据 YAML，路径相对启动时的工作目录；从仓库根目录启动。
DATA_CONFIG=examples/configs/data/catalog_smoke.yaml

# 训练输出目录，保存模型、优化器状态、日志和采样位置。
OUTPUT_DIR=runs/open_audio_llm_grpo_smoke

# 允许使用的物理 GPU 编号；本示例仅使用 2、3。
CUDA_VISIBLE_DEVICES=2,3

# 本机训练进程数，普通 DDP 应等于可见 GPU 数量。
NPROC_PER_NODE=2

# 优化器更新次数上限，SFT 动态 batch 要求为正数。
MAX_STEPS=1

# 每卡固定 batch 条数；SFT 设置 YAML 时长预算后由 batching 控制。
PER_DEVICE_TRAIN_BATCH_SIZE=1

# 每次优化器更新累积的 micro-batch 数。
GRADIENT_ACCUMULATION_STEPS=1

# GRPO 对每个 prompt 生成的回答数量，须至少为 2。
NUM_GENERATIONS=2

# 每个生成回答的最大 token 数。
MAX_COMPLETION_LENGTH=256

# 每多少次优化器更新保存一次 checkpoint。
SAVE_STEPS=1

# 每多少次更新输出训练日志。
LOGGING_STEPS=1

# 是否通过独立 vLLM server 生成 GRPO 回答；false 使用本地模型。
USE_VLLM=false

# 已启动的 rollout server 地址，仅 USE_VLLM=true 时使用。
VLLM_SERVER_HOST=127.0.0.1

# rollout server 端口，须与服务端一致。
VLLM_SERVER_PORT=8006

# ms-swift 内置 DeepSpeed 配置名，如 zero2；控制训练状态分片。
DEEPSPEED=zero2

# LoRA 低秩矩阵的秩；仅 tuner_type=lora 时生效。
LORA_RANK=64

# LoRA 缩放系数；实际缩放与 rank 有关。
LORA_ALPHA=128

# 优化器初始学习率。
LEARNING_RATE=1e-6

# 本机分布式通信端口；同时启动多任务时避免冲突。
MASTER_PORT=29502

# 每个 rank 的音频读取和增强子进程数；0 在主进程执行。
DATALOADER_NUM_WORKERS=2

# 是否冻结音频 encoder；false 时允许对应参数参与微调。
FREEZE_VIT=true

# 应用 LoRA 的模块；all-linear 表示符合冻结规则的线性层。
TARGET_MODULES=all-linear

# 训练精度；bfloat16 需要支持 bf16 的 GPU。
TORCH_DTYPE=bfloat16

# GRPO 每轮生成的全局样本数量，须满足生成分组与进程数约束。
GENERATION_BATCH_SIZE=4

# 生成采样温度；越高越随机。
TEMPERATURE=0.6

# 每步生成仅从概率最高的 k 个 token 中采样。
TOP_K=50

# 预热更新占总更新次数的比例，范围 [0,1]。
WARMUP_RATIO=0.05

# 最多保留的 checkpoint 数量。
SAVE_TOTAL_LIMIT=2

# 每多少次更新验证；需要 YAML 中存在 validation。
EVAL_STEPS=1

# 是否在训练日志中记录生成结果。
LOG_COMPLETIONS=true

# 等待 rollout server 的超时秒数。
VLLM_SERVER_TIMEOUT=600

# NCCL 通信日志级别；WARN 降低常规日志量。
NCCL_DEBUG=WARN

# 分布式通信超时，单位秒。
DDP_TIMEOUT=180000000
